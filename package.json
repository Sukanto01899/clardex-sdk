{
  "name": "@clardex/clardex-sdk",
  "version": "0.1.0",
  "description": "SDK for swapping and providing liquidity on Clardex pools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sukanto01899/clardex-sdk.git"
  },
  "homepage": "https://github.com/Sukanto01899/clardex-sdk#readme",
  "bugs": {
    "url": "https://github.com/Sukanto01899/clardex-sdk/issues"
  },
  "keywords": [
    "stacks",
    "clarity",
    "dex",
    "swap",
    "sdk",
    "defi"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "dev": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "release:check": "npm run lint && npm run build",
    "release:publish": "npm publish --access public"
  },
  "dependencies": {
    "@stacks/network": "^7.3.1",
    "@stacks/transactions": "^7.3.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.30",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.2",
    "typescript": "^5.6.3"
  }
}
